<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Jellybutter</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Common" ExcludeAssets="runtime" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Butterchurn is pinned by the repo's package.json and copied out of node_modules into the build, so
       the plugin serves it itself: nothing is loaded from a CDN. A build without node_modules runs
       `npm ci` once (node is required then; CI runs it on the runner before the dotnet container).
       Four preset packs ship: the base pack and the Extra, Extra2 and MD1 packs (each can be switched off). -->
  <PropertyGroup>
    <NpmRoot>$(MSBuildThisFileDirectory)..\</NpmRoot>
    <ButterchurnLib>$(NpmRoot)node_modules\butterchurn\lib\</ButterchurnLib>
    <PresetsLib>$(NpmRoot)node_modules\butterchurn-presets\lib\</PresetsLib>
    <ButterchurnOut>$(BaseIntermediateOutputPath)butterchurn\</ButterchurnOut>
  </PropertyGroup>

  <ItemGroup>
    <ButterchurnBundle Include="$(ButterchurnLib)butterchurn.min.js" />
    <ButterchurnBundle Include="$(PresetsLib)butterchurnPresets.min.js" />
    <ButterchurnBundle Include="$(PresetsLib)butterchurnPresetsExtra.min.js" />
    <ButterchurnBundle Include="$(PresetsLib)butterchurnPresetsExtra2.min.js" />
    <ButterchurnBundle Include="$(PresetsLib)butterchurnPresetsMD1.min.js" />
  </ItemGroup>

  <Target Name="RestoreButterchurn" Condition="!Exists('$(ButterchurnLib)butterchurn.min.js') Or !Exists('$(PresetsLib)butterchurnPresetsMD1.min.js')">
    <Message Importance="high" Text="node_modules is missing; running npm ci to fetch the pinned Butterchurn bundles." />
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(NpmRoot)" />
    <Error Condition="!Exists('$(ButterchurnLib)butterchurn.min.js') Or !Exists('$(PresetsLib)butterchurnPresetsMD1.min.js')" Text="npm ci did not produce the Butterchurn bundles under node_modules." />
  </Target>

  <Target Name="BundleButterchurn" DependsOnTargets="RestoreButterchurn" BeforeTargets="PrepareResources;BeforeCompile;CoreCompile" Inputs="@(ButterchurnBundle)" Outputs="@(ButterchurnBundle->'$(ButterchurnOut)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(ButterchurnBundle)" DestinationFolder="$(ButterchurnOut)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" LogicalName="Jellyfin.Plugin.Jellybutter.Configuration.configPage.html" />
    <EmbeddedResource Include="Web\jellybutter.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.jellybutter.js" />
    <EmbeddedResource Include="$(ButterchurnOut)butterchurn.min.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.butterchurn.min.js" />
    <EmbeddedResource Include="$(ButterchurnOut)butterchurnPresets.min.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.butterchurnPresets.min.js" />
    <EmbeddedResource Include="$(ButterchurnOut)butterchurnPresetsExtra.min.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.butterchurnPresetsExtra.min.js" />
    <EmbeddedResource Include="$(ButterchurnOut)butterchurnPresetsExtra2.min.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.butterchurnPresetsExtra2.min.js" />
    <EmbeddedResource Include="$(ButterchurnOut)butterchurnPresetsMD1.min.js" LogicalName="Jellyfin.Plugin.Jellybutter.Web.butterchurnPresetsMD1.min.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Jellybutter.Tests" />
  </ItemGroup>

</Project>
